# ===========================================================================
# Money Lending Management System — environment variable TEMPLATE
# ===========================================================================
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored.
#
#   cp .env.example .env.local
#
# NEVER commit real keys, passwords, tokens or connection strings.
# Validate your configuration at any time with:  npm run check:env
# ===========================================================================


# ---------------------------------------------------------------------------
# PUBLIC — safe to expose to the browser.
# Anything prefixed NEXT_PUBLIC_ is inlined into the client bundle by Next.js.
# Never put a secret behind a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key ("sb_publishable_..."). This is the modern
# replacement for the legacy `anon` key. It carries no privileges of its own —
# all access is governed by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Which deployment this is: development | test | staging | production
# Controls log verbosity and safety guards. Defaults to "development".
NEXT_PUBLIC_APP_ENV=development

# Public base URL of the deployed app, e.g. https://lending.example.com
# Used for absolute links (email callbacks, receipts). Optional in development.
NEXT_PUBLIC_SITE_URL=


# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS — must never reach the browser.
# These have NO NEXT_PUBLIC_ prefix, are read only from server modules, and
# are guarded by `server-only` imports in lib/env.server.ts.
# ---------------------------------------------------------------------------

# Supabase secret key ("sb_secret_..."), the modern replacement for the legacy
# `service_role` key. It BYPASSES Row Level Security.
#
# REQUIRED as of Phase 9. There is exactly one caller: the rate limiter, for a
# request that has no session yet — a sign-in attempt. `consume_rate_limit` is
# granted to `authenticated` and `service_role` and deliberately NOT to `anon`,
# because an anonymous caller who could reach it could exhaust a chosen
# account's sign-in budget and lock that person out. So the pre-authentication
# limiter counts through this key and does nothing else with it: it reads no
# data, writes no record, and the verdict it returns cannot widen anyone's
# access.
#
# Without it, sign-in fails closed — the limiter cannot be consulted, and an
# unlimited guessing attempt is worse than an outage. `npm run check:env` says
# so plainly.
#
# It must never be used to bypass an application authorization check.
SUPABASE_SECRET_KEY=

# Direct PostgreSQL connection string. Used ONLY by local developer tooling
# (migration verification, database integration tests) — never by the app.
# Example (local throwaway cluster): postgresql://postgres@localhost:5433/lending_test
DATABASE_URL=

# Minimum log level to emit: debug | info | warn | error
# Defaults to "debug" in development and "info" elsewhere.
LOG_LEVEL=
