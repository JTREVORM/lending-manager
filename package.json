{
  "name": "lending-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Money Lending Management System — Phase 1 foundation",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run --project unit --project integration",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "test:db": "vitest run --project db",
    "check:env": "tsx scripts/check-env.ts",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:lint": "supabase db lint",
    "db:types": "supabase gen types typescript --local --schema public > types/database.types.ts",
    "db:local:setup": "bash scripts/pg-local.sh setup",
    "db:local:teardown": "bash scripts/pg-local.sh teardown",
    "db:local:migrate": "bash scripts/pg-local.sh migrate",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:run && npm run build",
    "audit:money": "node scripts/audit-financial-arithmetic.mjs",
    "e2e:up": "bash tests/e2e/harness/stack.sh up",
    "e2e:down": "bash tests/e2e/harness/stack.sh down",
    "e2e:env": "bash tests/e2e/harness/stack.sh env",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "clsx": "2.1.1",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "^4.13.0",
    "dotenv": "18.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "pg": "8.23.1",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
